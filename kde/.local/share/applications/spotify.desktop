#!/usr/bin/env xdg-open
[Desktop Entry]
Categories=Audio;Music;Player;AudioVideo;
Comment=
Exec=spotify --uri=%u
GenericName=Music Player
Icon=spotify-client
MimeType=x-scheme-handler/spotify;
Name=Spotify
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
StartupWMClass=spotify
Terminal=false
TerminalOptions=
TryExec=spotify
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=

{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "shell",
          "style": "plain",
          "foreground": "#55c376",
          "powerline_symbol": "\ue0b0",
          "template": "$ \uf489 {{ .Name }} ",
          "cache": {
            "duration": "24h",
            "strategy": "session"
          }
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#03c9a8",
          "template": "\uf2bd {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#5cd3ff",
          "template": "\uf07b {{ .Path }} ",
          "options": {
            "folder_separator_icon": "/",
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#00cc58",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_upstream_icon": true
          }
        },
        {
          "foreground": "#65e28a",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "<#A47E9D>\u276f\u276f</> ",
          "type": "status"
        }
      ]
    }
  ]
}

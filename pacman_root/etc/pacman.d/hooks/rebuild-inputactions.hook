[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plasma-meta
Target = libplasma
Target = kdeplasma-addons

[Action]
Description = Action Required: Rebuild the inputactions-win AUR package to fix touchpad gestures on update.
When = PostTransaction
Exec = /usr/bin/echo -e "\e[1;31m=== ATTENTION ===\e[0m\n\e[1;33mPlease run:\e[0m yay -S inputactions-kwin --answerclean All --rebuild\n\e[1;33mto rebuild and fix the touchpad gestures.\e[0m"

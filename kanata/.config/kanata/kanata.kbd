(defsrc
  f23
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer default
  @f23
  caps 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    @chs @chd @chf g    h    @chj @chk @chl ;    '    ret
  @sft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl @met @alt           spc            ralt rmet rctl
)

(deflayer altlayer
  @f23
  caps 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    ;    '    ret
  @sft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl @met lalt           spc            ralt rmet rctl
)

(deflayer move
  @f23
  caps 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    @p   @[   @]   \
  @cap a    s    d    f    g    @h   @j   @k   @l    ;    '    ret
  @sft z    x    c    v    b    @n   m    ,    .    /    rsft
  lctl @met lalt           spc            ralt rmet rctl
)

(defalias

  cap (tap-hold-release 300 150 esc lctl)

  chs (chord sdf s)
  chd (chord sdf d)
  chf (chord sdf f)

  chj (chord jkl j)
  chk (chord jkl k)
  chl (chord jkl l)

  f23 (chord cop f)
  sft (chord cop s)
  met (chord cop m)

  tab (tap-hold-release 300 150 tab (multi lctl lalt lmet (layer-while-held move)))
  alt (multi lalt (layer-while-held altlayer))
  h   (unmod left)
  j   (unmod down)
  k   (unmod up)
  l   (unmod right)  
  [   (unmod lctl left)
  ]   (unmod lctl right)

;;Uncomment the first two for windows and second two for kde 
;;n   (unmod (lctl lmet) tab)
;;p   (unmod (lctl lmet) lsft tab)
  n   n
  p   p
)

(defchords sdf 30
  (s      ) s
  (   d   ) d
  (      f) f
  (s  d   ) (multi lsft lctl lalt lmet)
  (   d  f) (multi lsft lalt lmet)
)

(defchords jkl 30
  (j      ) j
  (   k   ) k
  (      l) l
  (j  k   ) (multi lsft lalt lmet)
  (   k  l) (multi lsft lctl lalt lmet)
)

(defchords cop 10
  (f      ) f23
  (   s   ) lsft
  (      m) lmet
  (   s  m) (multi lsft lmet)
  (f  s  m) rctl
)


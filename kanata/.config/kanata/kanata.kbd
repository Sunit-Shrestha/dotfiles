(defsrc
  f23
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayermap default
#|
  q     (t! mod-release q lctl)
  ;     (t! mod-press   ; lctl)
  d     (chord tiling d)
  f     (chord tiling f)
|#

  s     (t! mod-release   s (multi lctl lalt lmet))
  d     (t! mod-release   d (multi lsft lalt lmet))
  f     (t! mod-release   f (multi lsft lctl lalt lmet))
  q     (t! mod-release   q (multi lctl (layer-while-held ctl)))
  ;     (t! mod-press     ; (multi lctl (layer-while-held ctl)))

  esc   caps
  caps  (tap-hold-press 300 200 esc (layer-while-held subl))

;;alt   (multi lalt (layer-while-held altlayer))
;;tab   (tap-hold-press 300 200 tab (multi lsft lalt lmet))

  f23   (chord copilot f)
  sft   (chord copilot s)
  met   (chord copilot m)

)

(deflayermap subl
  h     left
  j     down
  k     up
  l     right
  p     bspc
  ;     ret
  '     (multi lctl bspc)
  [     (multi lctl left)
  ]     (multi lctl right)

  a     S-2
  s     S-3
  d     S-4
  f     S-1
  z     S-5
  x     S-6
  c     S-7
  v     S-8

  y     S-=
  u     S--
  i     =
  o     -

  q     S-,
  w     [
  e     S-[
  r     S-9
  m     S-.
  ,     ]
  .     S-]
  /     S-0

  t     S-`
  g     `
  b     \
  n     S-\
)

(deflayermap ctl
  s     s 
  d     d 
  f     f 
  q     q
  ;     ;
  spc   (unmod ; spc)
)

(deflayermap altlayer
  tab   tab
)

(deftemplate mod-release (char mod)
  (switch 
    ((key-timing 1 less-than 100)) $char break
    () (tap-hold-release-timeout 300 300 $char $mod $char) break
  )
)
(deftemplate mod-press (char mod)
  (switch 
    ((key-timing 1 less-than 100)) $char break
    () (tap-hold-press-timeout 300 300 $char $mod $char) break
  )
)

#|
(defchords tiling 30
  (d   )    d
  (   f)    f
  (d  f)    (multi lctl lalt lmet)
)
|#

(defchords copilot 10
  (f      ) f23
  (   s   ) lsft
  (      m) lmet
  (   s  m) (multi lsft lmet)
  (f  s  m) rctl
)

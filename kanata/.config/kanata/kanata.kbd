(defsrc
  f23 del
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayermap default
  s     (t! mod-release   s (multi lmet))
  d     (t! mod-release   d (multi lmet lctl))
  f     (t! mod-release   f (multi lmet lctl lalt))

  tab   (t! mod-press     tab (multi lctl (layer-while-held ctll)))
  ;     (t! mod-press     ;   (multi lctl (layer-while-held ctlr)))

  esc   caps
  caps  (tap-hold-press 300 200 esc (layer-while-held subl))

  f23   (chord copilot f)
  sft   (chord copilot s)
  met   (chord copilot m)
)

(deflayermap subl
  h     left
  j     down
  k     up
  l     right
  ;     bspc
  '     ret
  p     (multi lctl bspc)
  [     (multi lctl left)
  ]     (multi lctl right)

  a     S-2
  s     S-3
  d     S-4
  f     S-1
  z     S-5
  x     S-6
  c     S-7
  v     S-8

  y     S-=
  u     S--
  i     =
  o     -

  q     S-,
  w     [
  e     S-[
  r     S-9
  m     S-.
  ,     ]
  .     S-]
  /     S-0

  t     S-`
  g     `
  b     \
  n     S-\
)

(deflayermap ctll
  s     s 
  d     d 
  f     f 
  q     q
  ;     ;
  spc   (unmod q spc)
)

(deflayermap ctlr
  s     s 
  d     d 
  f     f 
  q     q
  ;     ;
  spc   (unmod ; spc)
)

(defchords copilot 10
  (f      ) f23
  (   s   ) lsft
  (      m) lmet
  (   s  m) (multi lsft lmet)
  (f  s  m) rctl
)

(deftemplate mod-release (char mod)
  (switch 
    ((key-timing 2 less-than 150)) $char break
    () (tap-hold-release-timeout 300 300 $char $mod $char) break
  )
)
(deftemplate mod-press (char mod)
  (switch 
    ((key-timing 2 less-than 150)) $char break
    () (tap-hold-press-timeout 300 300 $char $mod $char) break
  )
)

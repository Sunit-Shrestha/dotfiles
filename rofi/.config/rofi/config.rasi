@theme "/dev/null"

* {
  background:     #292a36FF;
  background-alt: #30313fFF;
  foreground:     #E5E9F0FF;
  selected:       #3e3b53FF;
  border:         #81A1C1FF;
  active:         #A3BE8CFF;
  urgent:         #BF616AFF;
  font:           "FiraCode Nerd Font 11";

  spacing: 0;  
  background-color: @background;
}

configuration {
  run,drun {
    fallback-icon: "application-x-addon";
  }
  filebrowser {
    directory: "~";
  }
  kb-custom-1: "Control+Alt+Super+i"; 
  kb-custom-2: "Control+Alt+Super+period"; 
  kb-custom-3: "Control+Alt+Super+w"; 
  kb-custom-4: "Control+Alt+Super+l"; 
  kb-custom-5: "Control+Alt+Super+comma"; 
  kb-mode-previous: "Control+Alt+Super+j";
  kb-mode-next: "Control+Alt+Super+k";
  modi: "drun,run,wifi:~/.config/rofi/scripts/wifi.sh,filebrowser,window";
  window-format: "{c}\t{t}";
  show-icons:                 true;
  display-drun:               " ";
  display-run:                " ";
  display-filebrowser:        " ";
  display-window:             " ";
  drun-display-format:        "{name}";
}

window {
	transparency:                "real";
  location:                    center;
  anchor:                      center;
  fullscreen:                  false;
  width:                       33%;
  x-offset:                    0px;
  y-offset:                    0px;
  enabled:                     true;
  margin:                      0px;
  padding:                     0px;
  border:                      1px solid;
  border-radius:               12px;
  border-color:                @border;
  background-color:            @background;
  cursor:                      "default";
}

mainbox {
  enabled:                     true;
  spacing:                     10px;
  margin:                      20px;
  padding:                     0px;
  border:                      0px solid;
  border-radius:               0px 0px 0px 0px;
  border-color:                @border;
  background-color:            transparent;
  children:                    [mode-switcher, inputbar, listview];
}

inputbar {
  enabled:                     true;
  spacing:                     5px;
  margin:                      8px 0px;
  padding:                     10px;
  border:                      1px solid;
  border-radius:               8px;
  border-color:                @border;
  background-color:            @background-alt;
  text-color:                  @foreground;
  children:                    [ "prompt", "entry" ];
}

prompt {
  padding: 0px 5px;
  enabled:                     true;
  background-color:            inherit;
  text-color:                  inherit;
}

textbox-prompt-colon {
  enabled:                     false;
  expand:                      false;
  str:                         "::";
  background-color:            inherit;
  text-color:                  inherit;
}

entry {
  enabled:                     true;
  background-color:            inherit;
  text-color:                  inherit;
  cursor:                      text;
  placeholder:                 "Search";
  placeholder-color:           inherit;
}

case-indicator {
	text-color: @foreground;
}

mode-switcher, message {
	border: 1px 1px;
    border-radius:  8px;
	border-color: @border;
}

button, textbox {
	background-color: @background;
	text-color: @foreground;
	padding: 8px;
}

button selected {
	background-color: @background-alt;
}

listview {
  enabled:                     true;
  lines:                       10;
  cycle:                       true;
  dynamic:                     true;
  scrollbar:                   false;
  layout:                      vertical;
  reverse:                     false;
  fixed-height:                true;

  flow:                        vertical;
  spacing:                     0px;
  margin:                      0px;
  padding:                     0px;
  border:                      0px solid;
  border-radius:               0px;
  border-color:                @border;
  background-color:            transparent;
  text-color:                  @foreground;
  cursor:                      "default";
}

scrollbar {
  handle-width:                5px ;
  handle-color:                @border;
  border-radius:               0px;
  background-color:            @background-alt;
}

element {
  enabled:                     true;
  spacing:                     8px;
  margin:                      0px;
  padding:                     8px 10px;
  border:                      0px solid;
  border-radius:               0px;
  border-color:                @border;
  background-color:            transparent;
  text-color:                  @foreground;
  orientation:                 horizontal;
  cursor:                      pointer;
}

element normal {
  background-color:            transparent;
  text-color:                  @foreground;
}

element selected {
  border:                      1px solid;
  border-radius:               8px;
  border-color:                @border;
  background-color:            @selected;
  text-color:                  @foreground;
}

element-icon {
  background-color:            transparent;
  text-color:                  inherit;
  size:                        24px;
  cursor:                      inherit;
}

element-text {
  background-color:            transparent;
  text-color:                  inherit;
  highlight:                   inherit;
  cursor:                      inherit;
  vertical-align:              0.5;
  horizontal-align:            0;
}

error-message {
  padding:                     5px;
  border:                      1px solid;
  border-radius:               8px;
  border-color:                @border;
  background-color:            black / 10%;
  text-color:                  @foreground;
}

textbox {
  background-color:            transparent;
  text-color:                  @foreground;
  vertical-align:              0.5;
  horizontal-align:            0.0;
  highlight:                   none;
}

